// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// prisma/schema.prisma — accanto al model Session esistente

model DraftQuote {
  id               String    @id                  // GID: gid://shopify/DraftOrder/{id}
  shop             String                          // quale negozio (isola i dati per merchant)
  status           String                          // "open" | "invoice_sent" | "completed"
  totalValue       Decimal   @db.Decimal(12, 2)    // valore del preventivo
  currency         String
  shopifyCreatedAt DateTime                         // quando l'ha creato Shopify (non la nostra riga)
  completedAt      DateTime?                         // valorizzato solo se convertito
  daysToConvert    Int?                              // giorni creazione → conversione
  deletedAt        DateTime?                         // valorizzato solo se eliminato
  rowUpdatedAt     DateTime  @updatedAt              // ultimo tocco della NOSTRA riga

  @@index([shop, status])
  @@index([shop, deletedAt])
  @@index([shop, shopifyCreatedAt])
  @@map("draft_quotes")
}